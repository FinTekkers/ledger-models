      "chunkSize": 5000,
      "points": [["2026-11-20", "15204137000.00"]],
      "expectedChunks": [["2026-11-20"]],
      "expectedValues": ["15204137000"]
    },
    {
      "name": "points_are_sorted_ascending",
      "metric": "NAV_PER_SHARE",
      "chunkSize": 5000,
      "points": [["2026-11-20", "512.34"], ["2026-11-18", "510.1"], ["2026-11-19", "511.25"]],
      "expectedChunks": [["2026-11-18", "2026-11-19", "2026-11-20"]],
      "expectedValues": ["510.1", "511.25", "512.34"]
