# no-arm-term.sh allowlist (LM-418): <path><TAB><text>. A hit is allowed
# when its line contains <text>, or <text> is * for the whole file. Keep this
# to the deprecated aliases, their notes and tests, the legacy-key loader
# fallback, and the LM-418 release note and versioning row. Remove the alias
# and fallback lines with the aliases.

# The LM-418 checks themselves.
scripts/checks/no-arm-term.sh	*
scripts/checks/no-arm-term.allow	*
scripts/checks/no-arm-term.test.sh	*
scripts/checks/hierarchy-rename-only.py	*
scripts/checks/test.sh	echo "== no arm term (LM-418)"
scripts/checks/test.sh	# "input type", never "arm", outside the deprecated aliases (allowlisted).
scripts/checks/test.sh	scripts/checks/no-arm-term.
scripts/checks/test.sh	# valuation_arms key; later items change the wire through wire-diff.py.
scripts/checks/test.sh	grep -q '"valuation_arms"'

# Release note and the schema_version 1.4 row.
docs/release-notes/lm-418.md	*
ledger-models-protos/registry-versioning.md	(`schema_version` 1.4, LM-418)

