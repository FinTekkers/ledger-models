{
  "description": "Shared oracle for the compact DecimalValueProto form (LM-294, docs/adr/compact_decimal.md). value = unscaled x 10^-scale. unscaled_hex is minimal two's-complement big-endian. wire_hex is the whole DecimalValueProto as a writer emits it: field 11 (unscaled_value), then field 12 (scale, left out when 0). The old string field 10 is gone (LM-318); canonical is the plain-notation string a reader prints. Every language must produce wire_hex exactly and decode it to the same unscaled value and scale.",
  "limits": {
    "max_digits": 4096,
    "max_scale": 4096,
    "max_unscaled_bytes": 1702
  },
  "cases": [
    {
      "name": "zero",
      "string": "0",
      "canonical": "0",
      "unscaled_hex": "00",
      "scale": 0,
      "wire_hex": "5a0100",
      "note": "Zero is the single byte 0x00, so a set zero is never empty."
    },
    {
      "name": "zero_scale_2",
      "string": "0.00",
      "canonical": "0.00",
      "unscaled_hex": "00",
      "scale": 2,
      "wire_hex": "5a01006002"
    },
    {
      "name": "negative_zero",
      "string": "-0.00",
      "canonical": "0.00",
      "unscaled_hex": "00",
      "scale": 2,
      "wire_hex": "5a01006002",
      "note": "Zero has no sign. The scale is kept."
    },
    {
      "name": "minus_one",
      "string": "-1",
      "canonical": "-1",
      "unscaled_hex": "ff",
      "scale": 0,
      "wire_hex": "5a01ff"
    },
    {
      "name": "one_fifty",
      "string": "1.50",
      "canonical": "1.50",
      "unscaled_hex": "0096",
      "scale": 2,
      "wire_hex": "5a0200966002",
      "note": "Scale 2 is kept: not 1.5."
    },
    {
      "name": "negative",
      "string": "-123.45",
