{
  // Check only, never emits (LM-473, LM-475). Consumers' svelte-check compiles
  // the shipped wrapper .ts with importsNotUsedAsValues: error, isolatedModules
  // and preserveValueImports, so a type-only plain import, or a type name
  // without an inline `type` in a mixed import, must fail here first.
  // preserveValueImports needs an ES module setting, hence module: esnext; the
  // build tsconfig.json (commonjs) is unchanged. The *.test.ts files use
  // `import x = require()`, which esnext rejects, and consumers never compile
  // them, so they are left out.
  // TypeScript 5.5+ removes these options: switch to verbatimModuleSyntax.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "isolatedModules": true,
    "preserveValueImports": true,
    "importsNotUsedAsValues": "error",
    "ignoreDeprecations": "5.0"
  },
  "include": ["node/wrappers/**/*"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
